rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Auto-numbering: a record's number must equal the prefix plus the counter value written in the SAME commit.
    function padNum(n) { return n < 10 ? '00' + string(n) : (n < 100 ? '0' + string(n) : string(n)); }
    function counterPath(kind) { return /databases/$(database)/documents/financeCounters/$(kind); }
    function counterBefore(kind) { return exists(counterPath(kind)) ? get(counterPath(kind)).data.last : 0; }
    function finNumber(kind) { return (kind == 'invoice' ? 'B34ST-INV-' : 'B34ST-QUO-') + padNum(getAfter(counterPath(kind)).data.last); }
    function signedIn() { return request.auth != null; }
    function roleDoc() { return get(/databases/$(database)/documents/roles/$(request.auth.uid)); }
    function active() { return signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)) && roleDoc().data.active == true; }
    function role() { return roleDoc().data.role; }
    function hasRole(roles) { return active() && role() in roles; }
    function admin() { return hasRole(['admin']); }
    function unchanged(field) { return request.resource.data[field] == resource.data[field]; }
    function timestampsOnCreate() { return request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid; }
    function timestampsOnUpdate() { return unchanged('createdAt') && unchanged('createdBy') && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid; }
    function publicProfile(data) { return data.keys().hasOnly(['name','jobTitle','department','workEmail','status','createdAt','createdBy','updatedAt','updatedBy']) && data.name is string && data.name.size() > 0 && data.name.size() <= 120 && data.jobTitle is string && data.jobTitle.size() <= 120 && data.department is string && data.department.size() <= 80 && data.workEmail is string && data.workEmail.size() <= 254 && data.status in ['active','inactive']; }
    function privateProfile(data) { return data.keys().hasOnly(['phone','employmentType','reportsTo','startDate','emergencyContact','hrNotes','createdAt','createdBy','updatedAt','updatedBy']) && data.phone is string && data.phone.size() <= 40 && data.employmentType is string && data.employmentType.size() <= 80 && data.reportsTo is string && data.reportsTo.size() <= 128 && data.startDate is timestamp && data.emergencyContact is string && data.emergencyContact.size() <= 500 && data.hrNotes is string && data.hrNotes.size() <= 4000; }
    function task(data) { return data.keys().hasOnly(['title','description','department','assigneeId','status','priority','dueDate','createdAt','createdBy','updatedAt','updatedBy']) && (!('priority' in data) || data.priority in ['low','medium','high','urgent']) && (!('dueDate' in data) || data.dueDate == null || data.dueDate is timestamp) && data.title is string && data.title.size() > 0 && data.title.size() <= 200 && data.description is string && data.description.size() <= 4000 && data.department in ['technical','business','digital','creative'] && data.assigneeId is string && data.status in ['todo','in_progress','done']; }
    function audit(data) { return data.keys().hasOnly(['actorId','action','targetType','targetId','createdAt']) && data.actorId == request.auth.uid && data.action is string && data.action.size() <= 100 && data.targetType is string && data.targetType.size() <= 100 && data.targetId is string && data.targetId.size() <= 150 && data.createdAt == request.time; }
    function onboarding(data) { return data.keys().hasOnly(['subjectId','title','status','department','createdAt','createdBy','updatedAt','updatedBy']) && data.subjectId is string && data.subjectId.size() <= 128 && data.title is string && data.title.size() > 0 && data.title.size() <= 200 && data.status in ['not_started','in_progress','complete'] && data.department in ['technical','business','digital','creative']; }
    function attendanceRecord(data) { return data.keys().hasOnly(['employeeId','dateKey','checkInAt','checkOutAt','createdAt','updatedAt']) && data.employeeId is string && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.checkInAt is timestamp && (data.checkOutAt == null || data.checkOutAt is timestamp); }
    function leaveRecord(data) { return data.keys().hasOnly(['employeeId','approverId','type','startDate','endDate','days','reason','status','decisionNote','decidedBy','decidedAt','createdAt','updatedAt']) && data.employeeId is string && data.approverId is string && data.type in ['Annual leave','Sick leave','Family responsibility','Unpaid leave','Other'] && data.startDate is string && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.endDate is string && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.endDate >= data.startDate && data.days is int && data.days > 0 && data.days <= 366 && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 1500 && data.status in ['pending','approved','rejected'] && data.decisionNote is string && data.decisionNote.size() <= 1500 && data.decidedBy is string; }
    function announcement(data) { return data.keys().hasOnly(['title','body','status','createdAt','createdBy','updatedAt','updatedBy']) && data.title is string && data.title.size() > 0 && data.title.size() <= 200 && data.body is string && data.body.size() > 0 && data.body.size() <= 4000 && data.status in ['draft','published','archived']; }
    function lead(data) { return data.keys().hasOnly(['company','contactName','email','phone','source','stage','notes','nextFollowUpAt','createdAt','createdBy','updatedAt','updatedBy']) && data.company is string && data.company.size() > 0 && data.company.size() <= 160 && data.contactName is string && data.contactName.size() > 0 && data.contactName.size() <= 160 && data.email is string && data.email.size() <= 254 && data.phone is string && data.phone.size() <= 40 && data.source in ['Website','Referral','Cold outreach','Event','Social','Social media','Email','Phone','Other'] && data.stage in ['New','Contacted','Proposal','Won','Lost'] && data.notes is string && data.notes.size() <= 3000 && data.nextFollowUpAt is string && (data.nextFollowUpAt == '' || data.nextFollowUpAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function client(data) { return data.keys().hasOnly(['company','contactName','email','phone','industry','status','notes','createdAt','createdBy','updatedAt','updatedBy']) && data.company is string && data.company.size() > 0 && data.company.size() <= 160 && data.contactName is string && data.contactName.size() > 0 && data.contactName.size() <= 160 && data.email is string && data.email.size() <= 254 && data.phone is string && data.phone.size() <= 40 && data.industry is string && data.industry.size() <= 160 && data.status in ['active','inactive'] && data.notes is string && data.notes.size() <= 3000; }
    function str(data, k, max) { return data[k] is string && data[k].size() <= max; }
    function intake(data) { return data.keys().hasOnly(['businessName','contactName','leadId','clientId','projectId','tagline','whatTheyDo','location','whatsapp','email','phone','social','pages','otherPages','categories','products','services','steps','about','facts','colors','styles','likes','photos','domain','deadline','avoid','status','source','createdAt','createdBy','updatedAt','updatedBy']) && str(data,'businessName',160) && data.businessName.size() > 0 && str(data,'contactName',160) && (!('leadId' in data) || str(data,'leadId',128)) && (!('clientId' in data) || str(data,'clientId',128)) && (!('projectId' in data) || str(data,'projectId',128)) && str(data,'tagline',200) && str(data,'whatTheyDo',1000) && data.whatTheyDo.size() > 0 && str(data,'location',160) && data.location.size() > 0 && str(data,'whatsapp',40) && str(data,'email',254) && str(data,'phone',40) && (data.whatsapp.size() > 0 || data.email.size() > 0 || data.phone.size() > 0) && str(data,'social',1000) && data.pages is list && data.pages.size() <= 10 && str(data,'otherPages',300) && str(data,'categories',500) && data.products is list && data.products.size() <= 30 && data.services is list && data.services.size() <= 20 && str(data,'steps',1000) && str(data,'about',2000) && str(data,'facts',1000) && str(data,'colors',200) && data.styles is list && data.styles.size() <= 6 && str(data,'likes',1000) && data.photos is list && data.photos.size() <= 3 && str(data,'domain',253) && str(data,'deadline',100) && str(data,'avoid',1000) && data.status in ['new','in_review','building','delivered','archived'] && data.source in ['staff','client_summary','client_form']; }
    function near(a, b) { return math.abs(a - b) < 0.005; }
    function financeRecord(data) { return data.keys().hasOnly(['kind','number','clientId','clientName','title','description','amountZmw','paidAmountZmw','issueDate','dueDate','status','createdAt','createdBy','updatedAt','updatedBy']) && data.kind in ['quotation','invoice'] && data.number is string && data.number.size() > 0 && data.number.size() <= 40 && data.clientId is string && data.clientId.size() > 0 && data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 160 && data.title is string && data.title.size() > 0 && data.title.size() <= 180 && data.description is string && data.description.size() <= 2500 && data.amountZmw is number && data.amountZmw > 0 && data.paidAmountZmw is number && data.paidAmountZmw >= 0 && data.paidAmountZmw <= data.amountZmw + 0.005 && data.issueDate is string && data.issueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.dueDate is string && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.dueDate >= data.issueDate && ((data.kind == 'quotation' && data.paidAmountZmw == 0 && data.status in ['draft','sent','accepted','rejected']) || (data.kind == 'invoice' && data.status in ['unpaid','partial','paid','overdue','void'])); }
    function financePayment(data) { return data.keys().hasOnly(['invoiceId','invoiceNumber','clientName','amountZmw','date','method','reference','createdAt','createdBy']) && data.invoiceId is string && data.invoiceNumber is string && data.clientName is string && data.amountZmw is number && data.amountZmw > 0 && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.method in ['Bank transfer','Mobile money','Cash','Card','Other'] && data.reference is string && data.reference.size() <= 100 && data.createdAt == request.time && data.createdBy == request.auth.uid; }
    function project(data) { return data.keys().hasOnly(['name','clientId','clientName','description','status','priority','startDate','dueDate','managerId','memberIds','milestones','createdAt','createdBy','updatedAt','updatedBy']) && data.name is string && data.name.size() > 0 && data.name.size() <= 160 && data.clientId is string && data.clientName is string && data.clientName.size() <= 160 && data.description is string && data.description.size() <= 4000 && data.status in ['planning','active','on_hold','completed'] && data.priority in ['low','medium','high','urgent'] && data.startDate is string && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.dueDate is string && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.dueDate >= data.startDate && data.managerId is string && data.memberIds is list && data.memberIds.size() > 0 && data.memberIds.size() <= 100 && data.milestones is list && data.milestones.size() <= 100; }

    match /roles/{uid} {
      allow read: if active() && (admin() || request.auth.uid == uid);
      allow create: if admin() && request.auth.uid != uid && request.resource.data.keys().hasOnly(['role','dept','active','createdAt','createdBy','updatedAt','updatedBy']) && request.resource.data.role in ['admin','bizops','digitalops','designer','employee'] && request.resource.data.dept in ['technical','business','digital','creative'] && request.resource.data.active is bool && timestampsOnCreate();
      allow update: if admin() && request.auth.uid != uid && request.resource.data.keys().hasOnly(['role','dept','active','createdAt','createdBy','updatedAt','updatedBy']) && request.resource.data.role in ['admin','bizops','digitalops','designer','employee'] && request.resource.data.dept in ['technical','business','digital','creative'] && request.resource.data.active is bool && timestampsOnUpdate();
      allow delete: if false;
    }
    match /users/{uid} {
      allow read: if active();
      allow create: if admin() && publicProfile(request.resource.data) && timestampsOnCreate();
      allow update: if admin() && publicProfile(request.resource.data) && timestampsOnUpdate();
      allow delete: if admin();
    }
    match /userPrivate/{uid} {
      allow read: if active() && (admin() || request.auth.uid == uid);
      allow create: if admin() && privateProfile(request.resource.data) && timestampsOnCreate();
      allow update: if admin() && privateProfile(request.resource.data) && timestampsOnUpdate();
      allow delete: if admin();
    }
    match /tasks/{id} {
      allow read: if active() && (admin() || (role() == 'bizops' && resource.data.department == 'business') || (role() == 'digitalops' && resource.data.department == 'digital') || (role() == 'designer' && resource.data.department == 'creative') || resource.data.assigneeId == request.auth.uid);
      allow create: if active() && task(request.resource.data) && timestampsOnCreate() && (admin() || (role() == 'bizops' && request.resource.data.department == 'business') || (role() == 'digitalops' && request.resource.data.department == 'digital') || (role() == 'designer' && request.resource.data.department == 'creative'));
      allow update: if active() && task(request.resource.data) && timestampsOnUpdate() && (admin() || ((role() in ['bizops','digitalops','designer','employee']) && resource.data.assigneeId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy'])) || ((role() == 'bizops' && resource.data.department == 'business') || (role() == 'digitalops' && resource.data.department == 'digital') || (role() == 'designer' && resource.data.department == 'creative')));
      allow delete: if admin();
    }
    match /onboarding/{id} {
      allow read: if active() && (admin() || role() == 'bizops' || resource.data.subjectId == request.auth.uid);
      allow create: if active() && onboarding(request.resource.data) && timestampsOnCreate() && (admin() || role() == 'bizops');
      allow update: if active() && onboarding(request.resource.data) && timestampsOnUpdate() && (admin() || role() == 'bizops');
      allow delete: if admin();
    }
    match /attendance/{id} {
      allow read: if active() && (admin() || resource.data.employeeId == request.auth.uid);
      allow create: if active() && attendanceRecord(request.resource.data) && request.resource.data.employeeId == request.auth.uid && id == request.auth.uid + '_' + request.resource.data.dateKey && request.resource.data.checkInAt == request.time && request.resource.data.checkOutAt == null && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if active() && attendanceRecord(request.resource.data) && resource.data.employeeId == request.auth.uid && request.resource.data.employeeId == resource.data.employeeId && request.resource.data.dateKey == resource.data.dateKey && request.resource.data.checkInAt == resource.data.checkInAt && resource.data.checkOutAt == null && request.resource.data.checkOutAt == request.time && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /leave/{id} {
      allow read: if active() && (admin() || resource.data.employeeId == request.auth.uid || resource.data.approverId == request.auth.uid);
      allow create: if active() && leaveRecord(request.resource.data) && request.resource.data.employeeId == request.auth.uid && request.resource.data.approverId == get(/databases/$(database)/documents/userPrivate/$(request.auth.uid)).data.reportsTo && request.resource.data.status == 'pending' && request.resource.data.decisionNote == '' && request.resource.data.decidedBy == '' && request.resource.data.decidedAt == null && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if active() && leaveRecord(request.resource.data) && request.resource.data.employeeId == resource.data.employeeId && request.resource.data.approverId == resource.data.approverId && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time && ((resource.data.employeeId == request.auth.uid && resource.data.status == 'pending' && request.resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type','startDate','endDate','days','reason','updatedAt'])) || ((admin() || resource.data.approverId == request.auth.uid) && request.resource.data.employeeId != request.auth.uid && resource.data.status == 'pending' && request.resource.data.status in ['approved','rejected'] && request.resource.data.decidedBy == request.auth.uid && request.resource.data.decidedAt == request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decisionNote','decidedBy','decidedAt','updatedAt'])));
      allow delete: if false;
    }
    match /leads/{id} {
      allow read: if hasRole(['admin','bizops']);
      allow create: if hasRole(['admin','bizops']) && lead(request.resource.data) && timestampsOnCreate();
      allow update: if hasRole(['admin','bizops']) && lead(request.resource.data) && timestampsOnUpdate() && unchanged('createdAt') && unchanged('createdBy');
      allow delete: if false;
    }
    match /intakes/{id} {
      allow read: if hasRole(['admin','bizops']);
      allow create: if hasRole(['admin','bizops']) && intake(request.resource.data) && timestampsOnCreate() && request.resource.data.status == 'new';
      allow update: if hasRole(['admin','bizops']) && intake(request.resource.data) && timestampsOnUpdate() && unchanged('source');
      allow delete: if false;
    }
    match /clients/{id} {
      allow read: if hasRole(['admin','bizops']);
      allow create: if hasRole(['admin','bizops']) && client(request.resource.data) && timestampsOnCreate();
      allow update: if hasRole(['admin','bizops']) && client(request.resource.data) && timestampsOnUpdate() && unchanged('createdAt') && unchanged('createdBy');
      allow delete: if false;
    }
    match /projects/{id} {
      allow read: if active() && (hasRole(['admin','bizops']) || request.auth.uid in resource.data.memberIds);
      allow create: if hasRole(['admin','bizops']) && project(request.resource.data) && timestampsOnCreate() && request.auth.uid in request.resource.data.memberIds;
      allow update: if hasRole(['admin','bizops']) && project(request.resource.data) && timestampsOnUpdate() && unchanged('createdAt') && unchanged('createdBy');
      allow delete: if false;
    }
    match /financeCounters/{kind} {
      allow read: if hasRole(['admin','bizops']);
      allow create, update: if hasRole(['admin','bizops']) && kind in ['invoice','quotation'] && request.resource.data.keys().hasOnly(['last','updatedAt','updatedBy']) && request.resource.data.last is int && request.resource.data.last > counterBefore(kind) && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /financeRecords/{id} {
      allow read: if hasRole(['admin','bizops']);
      allow create: if hasRole(['admin','bizops']) && financeRecord(request.resource.data) && timestampsOnCreate() && request.resource.data.paidAmountZmw == 0 && request.resource.data.number == finNumber(request.resource.data.kind);
      allow update: if hasRole(['admin','bizops']) && financeRecord(request.resource.data) && timestampsOnUpdate() && unchanged('createdAt') && unchanged('createdBy') && unchanged('kind') && unchanged('number') && unchanged('clientId') && unchanged('clientName') && unchanged('title') && unchanged('description') && unchanged('amountZmw') && unchanged('issueDate') && unchanged('dueDate') && ((request.resource.data.paidAmountZmw == resource.data.paidAmountZmw && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy']) && ((resource.data.kind == 'quotation' && request.resource.data.status in ['draft','sent','accepted','rejected']) || (resource.data.kind == 'invoice' && (request.resource.data.status == resource.data.status || (resource.data.paidAmountZmw == 0 && request.resource.data.status in ['unpaid','overdue','void']))))) || (resource.data.kind == 'invoice' && resource.data.status != 'void' && request.resource.data.paidAmountZmw > resource.data.paidAmountZmw && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidAmountZmw','status','updatedAt','updatedBy']) && ((near(request.resource.data.paidAmountZmw, resource.data.amountZmw) && request.resource.data.status == 'paid') || (request.resource.data.paidAmountZmw < resource.data.amountZmw - 0.005 && request.resource.data.status == 'partial'))));
      allow delete: if false;
    }
    match /financePayments/{id} {
      allow read: if hasRole(['admin','bizops']);
      allow create: if hasRole(['admin','bizops']) && financePayment(request.resource.data) && exists(/databases/$(database)/documents/financeRecords/$(request.resource.data.invoiceId)) && get(/databases/$(database)/documents/financeRecords/$(request.resource.data.invoiceId)).data.kind == 'invoice' && getAfter(/databases/$(database)/documents/financeRecords/$(request.resource.data.invoiceId)).data.paidAmountZmw >= get(/databases/$(database)/documents/financeRecords/$(request.resource.data.invoiceId)).data.paidAmountZmw + request.resource.data.amountZmw - 0.005;
      allow update, delete: if false;
    }
    // Written only by the server (api/send-receipt via the Admin SDK); staff can read delivery status.
    match /receipts/{id} {
      allow read: if hasRole(['admin','bizops']);
      allow write: if false;
    }
    match /announcements/{id} {
      allow read: if active();
      allow create: if active() && announcement(request.resource.data) && timestampsOnCreate() && (admin() || role() == 'bizops');
      allow update: if active() && announcement(request.resource.data) && timestampsOnUpdate() && (admin() || (role() == 'bizops' && resource.data.createdBy == request.auth.uid));
      allow delete: if admin();
    }

    function socialPost(data) { return data.keys().hasOnly(['title','channel','caption','scheduledAt','assetUrl','status','reviewerNote','createdAt','createdBy','updatedAt','updatedBy']) && data.title is string && data.title.size() > 0 && data.title.size() <= 160 && data.channel in ['Facebook','Instagram','LinkedIn','TikTok','X','YouTube','Website'] && data.caption is string && data.caption.size() > 0 && data.caption.size() <= 4000 && data.scheduledAt is string && (data.scheduledAt == '' || data.scheduledAt.size() <= 32) && data.assetUrl is string && data.assetUrl.size() <= 2048 && (data.assetUrl == '' || data.assetUrl.matches('^https?://.+$')) && data.status in ['draft','pending_approval','approved','scheduled','published','rejected'] && data.reviewerNote is string && data.reviewerNote.size() <= 1500; }
    function websiteRequest(data) { return data.keys().hasOnly(['title','description','pageUrl','priority','status','assignedTo','completionNote','createdAt','createdBy','updatedAt','updatedBy']) && data.title is string && data.title.size() > 0 && data.title.size() <= 160 && data.description is string && data.description.size() > 0 && data.description.size() <= 4000 && data.pageUrl is string && data.pageUrl.size() <= 2048 && (data.pageUrl == '' || data.pageUrl.matches('^https?://.+$')) && data.priority in ['Low','Normal','High','Urgent'] && data.status in ['submitted','triaged','in_progress','completed','rejected'] && data.assignedTo is string && data.assignedTo.size() <= 128 && data.completionNote is string && data.completionNote.size() <= 2000; }
    function digitalCampaign(data) { return data.keys().hasOnly(['name','objective','channels','startDate','endDate','budgetZmw','status','impressions','clicks','leads','conversions','createdAt','createdBy','updatedAt','updatedBy']) && data.name is string && data.name.size() > 0 && data.name.size() <= 160 && data.objective in ['Awareness','Engagement','Traffic','Lead generation','Sales','Retention'] && data.channels is list && data.channels.size() > 0 && data.channels.size() <= 6 && data.channels.hasOnly(['Facebook','Instagram','LinkedIn','TikTok','X','YouTube']) && data.startDate is string && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.endDate is string && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.endDate >= data.startDate && data.budgetZmw is number && data.budgetZmw >= 0 && data.status in ['planned','active','paused','completed'] && data.impressions is int && data.impressions >= 0 && data.clicks is int && data.clicks >= 0 && data.clicks <= data.impressions && data.leads is int && data.leads >= 0 && data.conversions is int && data.conversions >= 0 && data.conversions <= data.leads; }
    function contentAsset(data) { return data.keys().hasOnly(['name','category','platform','assetUrl','driveFileId','notes','createdAt','createdBy','updatedAt','updatedBy']) && data.name is string && data.name.size() > 0 && data.name.size() <= 160 && data.category in ['Image','Video','Document','Logo','Template','Other'] && data.platform is string && data.platform.size() <= 80 && data.assetUrl is string && data.assetUrl.size() > 0 && data.assetUrl.size() <= 2048 && data.assetUrl.matches('^https?://.+$') && (!('driveFileId' in data) || (data.driveFileId is string && data.driveFileId.size() > 0 && data.driveFileId.size() <= 100)) && data.notes is string && data.notes.size() <= 1500; }

    match /socialPosts/{id} {
      allow read: if active() && (hasRole(['admin','digitalops']) || (role() == 'designer' && resource.data.createdBy == request.auth.uid));
      allow create: if hasRole(['admin','digitalops','designer']) && socialPost(request.resource.data) && timestampsOnCreate() && request.resource.data.status == 'draft' && request.resource.data.createdBy == request.auth.uid;
      allow update: if active() && socialPost(request.resource.data) && timestampsOnUpdate() && unchanged('createdAt') && unchanged('createdBy') && ((hasRole(['admin','digitalops']) && ((admin() && request.resource.data.status in ['approved','rejected'] && resource.data.status == 'pending_approval' && resource.data.createdBy != request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewerNote','updatedAt','updatedBy'])) || (request.resource.data.status in ['scheduled','published'] && resource.data.status in ['approved','scheduled'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy']))) || (resource.data.createdBy == request.auth.uid && role() in ['admin','designer','digitalops'] && resource.data.status in ['draft','rejected'] && ((request.resource.data.status == resource.data.status && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','channel','caption','scheduledAt','assetUrl','updatedAt','updatedBy'])) || (request.resource.data.status == 'pending_approval' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy']))))));
      allow delete: if false;
    }
    match /websiteRequests/{id} {
      allow read: if active() && (hasRole(['admin','digitalops']) || resource.data.createdBy == request.auth.uid);
      allow create: if active() && websiteRequest(request.resource.data) && timestampsOnCreate() && request.resource.data.status == 'submitted' && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasRole(['admin','digitalops']) && websiteRequest(request.resource.data) && timestampsOnUpdate() && unchanged('createdAt') && unchanged('createdBy') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','assignedTo','completionNote','updatedAt','updatedBy']);
      allow delete: if false;
    }
    match /digitalCampaigns/{id} {
      allow read: if hasRole(['admin','digitalops','bizops']);
      allow create: if hasRole(['admin','digitalops','bizops']) && digitalCampaign(request.resource.data) && timestampsOnCreate() && request.resource.data.impressions == 0 && request.resource.data.clicks == 0 && request.resource.data.leads == 0 && request.resource.data.conversions == 0;
      allow update: if hasRole(['admin','digitalops','bizops']) && digitalCampaign(request.resource.data) && timestampsOnUpdate() && unchanged('createdAt') && unchanged('createdBy') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','impressions','clicks','leads','conversions','updatedAt','updatedBy']);
      allow delete: if false;
    }
    match /contentAssets/{id} {
      allow read: if hasRole(['admin','digitalops','designer']);
      allow create: if hasRole(['admin','digitalops','designer']) && contentAsset(request.resource.data) && timestampsOnCreate();
      allow update, delete: if false;
    }
    match /auditLogs/{id} { allow create: if admin() && audit(request.resource.data) && request.resource.data.targetType == 'user'; allow read: if admin(); allow update, delete: if false; }
    // Deny-by-default boundary. Future phases add narrow collection rules here.
    match /{document=**} { allow read, write: if false; }
  }
}
